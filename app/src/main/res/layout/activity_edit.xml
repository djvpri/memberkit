<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="6dp">

            <ImageButton
                android:id="@+id/back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="-8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Kembali"
                android:src="@drawable/ic_back" />

            <TextView
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="Tambah Member"
                android:textColor="@color/fg"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/delete"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Hapus"
                android:textColor="@color/red"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <TextView
                style="@style/FieldLabel"
                android:text="Nama member" />

            <EditText
                android:id="@+id/name"
                style="@style/FieldInput"
                android:hint="Contoh: Budi Santoso"
                android:inputType="textPersonName"
                android:importantForAutofill="no" />

            <TextView
                style="@style/FieldLabel"
                android:text="Aplikasi" />

            <EditText
                android:id="@+id/app"
                style="@style/FieldInput"
                android:hint="Contoh: Netflix Premium"
                android:inputType="textCapWords"
                android:importantForAutofill="no" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    style="@style/QuickChip"
                    android:id="@+id/q1"
                    android:text="1 bulan" />

                <TextView
                    style="@style/QuickChip"
                    android:id="@+id/q3"
                    android:text="3 bulan" />

                <TextView
                    style="@style/QuickChip"
                    android:id="@+id/q6"
                    android:text="6 bulan" />

                <TextView
                    style="@style/QuickChip"
                    android:id="@+id/q12"
                    android:text="1 tahun" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/FieldLabel"
                        android:text="Mulai" />

                    <TextView
                        android:id="@+id/start"
                        style="@style/FieldInput"
                        android:clickable="true"
                        android:focusable="true"
                        android:drawableEnd="@drawable/ic_calendar"
                        android:drawablePadding="6dp" />
                </LinearLayout>

                <Space
                    android:layout_width="10dp"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/FieldLabel"
                        android:text="Selesai" />

                    <TextView
                        android:id="@+id/end"
                        style="@style/FieldInput"
                        android:clickable="true"
                        android:focusable="true"
                        android:drawableEnd="@drawable/ic_calendar"
                        android:drawablePadding="6dp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/duration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/muted"
                android:textSize="11.5sp" />

            <TextView
                style="@style/FieldLabel"
                android:text="Keterangan" />

            <EditText
                android:id="@+id/note"
                style="@style/FieldInput"
                android:gravity="top|start"
                android:hint="Catatan, cara bayar, dsb (opsional)"
                android:inputType="textCapSentences|textMultiLine"
                android:minLines="3"
                android:importantForAutofill="no" />

            <TextView
                style="@style/FieldLabel"
                android:text="Biaya (Rp)" />

            <EditText
                android:id="@+id/price"
                style="@style/FieldInput"
                android:hint="65000"
                android:inputType="number"
                android:importantForAutofill="no" />

            <TextView
                android:id="@+id/error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/red"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/save"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_btn"
                android:gravity="center"
                android:text="Simpan Member"
                android:textColor="#FFFFFF"
                android:textSize="14.5sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
